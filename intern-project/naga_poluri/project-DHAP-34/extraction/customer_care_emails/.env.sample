# .env.sample
# Author: naga_poluri / Project: DHAP-34
#
# Copy this to .env and fill in your real values:
#   cp .env.sample .env
#
# Never commit .env to Git — it's in .gitignore

# target postgres where pipeline loads data
PG_HOST=your_postgres_host
PG_PORT=5432
PG_DB=your_database_name
PG_USER=your_postgres_user
PG_PASSWORD=your_postgres_password
PG_SCHEMA=public

# airflow metadata postgres (runs inside docker)
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# airflow settings
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False

# generate this with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here

# generate this with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_WEBSERVER_SECRET_KEY=your_secret_key_here
